{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jin10 Reader",
  "version": "0.1.5",
  "identifier": "io.github.jin10reader.desktop",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "金十阅读器 · Jin10 Reader",
        "width": 400,
        "height": 600,
        "minWidth": 320,
        "minHeight": 420,
        "resizable": true,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": false
      },
      {
        "label": "settings",
        "title": "设置",
        "url": "settings.html",
        "width": 440,
        "height": 640,
        "visible": false,
        "resizable": true,
        "minWidth": 360,
        "minHeight": 480,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'",
      "capabilities": [
        "main",
        "settings"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Finance",
    "license": "MIT",
    "licenseFile": "LICENSE",
    "resources": [
      "LICENSE",
      "licenses/third-party-licenses.md",
      "licenses/third-party-notices.txt",
      "resources/acrylic/"
    ],
    "shortDescription": "Independent desktop reader for Jin10 MCP",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
