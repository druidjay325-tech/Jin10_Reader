{
  "name": "jin10-reader-tools",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "description": "金十阅读器的离线检查与发布工具，无运行时 Node 依赖",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "scripts": {
    "check": "node tools/check-public.mjs",
    "test": "node --test tests/frontend.test.cjs tools/public-policy.test.mjs tools/binary-policy.test.mjs",
    "test:online": "node tools/online-smoke.mjs",
    "export": "node tools/export-public.mjs",
    "checksums": "node tools/checksums.mjs",
    "dev": "cargo run --locked",
    "build": "powershell -NoProfile -File tools/build-release.ps1"
  }
}
